import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score


1. PESQUISA E CONSTRUÇÃO DA BASE DE DADOS

dados = {
    'Ano': list(range(2006, 2026)),
    'PIB_indice': [
        138.2,
        146.6,
        154.1,
        153.9,
        165.4,
        172.0,
        175.3,
        180.6,
        181.5,
        175.1,
        169.3,
        171.6,
        174.7,
        176.8,
        171.0,
        179.2,
        184.6,
        190.0,
        195.5,
        200.2,
    ],
    'ABCR_indice': [
        115.4,
        122.8,
        131.0,
        136.2,
        148.5,
        156.1,
        160.8,
        164.5,
        168.1,
        164.3,
        159.8,
        161.2,
        163.7,
        168.0,
        146.2,
        159.5,
        168.9,
        176.4,
        182.1,
        187.5,
    ],
}

df = pd.DataFrame(dados)

print('--- BASE DE DADOS ORGANIZADA (2006 - 2025) ---')
print(df.head(20))
print('\nInformações do Dataset:')
print(df.info())

df.to_csv('dados_pib_abcr.csv', index=False)


2. ANÁLISE DA RELAÇÃO E CORRELAÇÃO

correlacao = df['PIB_indice'].corr(df['ABCR_indice'])
print(
    f'\nCorrelação de Pearson entre PIB_indice e ABCR_indice: {correlacao:.4f}'
)

plt.figure(figsize=(8, 5))
plt.scatter(
    df['PIB_indice'],
    df['ABCR_indice'],
    color='blue',
    alpha=0.7,
    edgecolors='k',
    s=60,
)
plt.title('Gráfico de Dispersão: PIB vs Índice ABCR (2006-2025)')
plt.xlabel('Índice do PIB (Média Anual)')
plt.ylabel('Índice ABCR (Média Anual)')
plt.grid(True, linestyle='--', alpha=0.6)
plt.show()


3. DIVISÃO EM TREINO E TESTE
Treino: Primeiros 16 anos (2006 a 2021) Teste: Últimos 4 anos (2022 a 2025)

df_treino = df[df['Ano'] <= 2021]
df_teste = df[df['Ano'] >= 2022]

X_train = df_treino[['PIB_indice']]
y_train = df_treino['ABCR_indice']

X_test = df_teste[['PIB_indice']]
y_test = df_teste['ABCR_indice']

print(f'\nTamanho do conjunto de Treino: {len(X_train)} anos (2006-2021)')
print(f'Tamanho do conjunto de Teste: {len(X_test)} anos (2022-2025)')


4. TREINAMENTO DO MODELO DE REGRESSÃO LINEAR

modelo = LinearRegression()
modelo.fit(X_train, y_train)

coef_angular = modelo.coef_[0]
intercepto = modelo.intercept_

print(f'\n--- PARÂMETROS DO MODELO ---')
print(f'Coeficiente Angular (Slope): {coef_angular:.4f}')
print(f'Intercepto (Bias): {intercepto:.4f}')
print(f'Equação: ABCR_estimado = {intercepto:.4f} + {coef_angular:.4f} * PIB')


5. PREDIÇÃO E AVALIAÇÃO DO MODELO NO TESTE

y_pred = modelo.predict(X_test)

mae = mean_absolute_error(y_test, y_pred)
mse = mean_squared_error(y_test, y_pred)
r2 = r2_score(y_test, y_pred)

tabela_comparativa = pd.DataFrame({
    'Ano': df_teste['Ano'].values,
    'PIB_indice': X_test['PIB_indice'].values,
    'ABCR_Observado': y_test.values,
    'ABCR_Previsto': np.round(y_pred, 2),
    'Erro_Absoluto': np.round(np.abs(y_test.values - y_pred), 2),
})

print('\n--- COMPARAÇÃO: OBSERVADO vs PREVISTO (CONJUNTO DE TESTE) ---')
print(tabela_comparativa.to_string(index=False))

print('\n--- MÉTRICAS DE AVALIAÇÃO NO TESTE ---')
print(f'MAE (Erro Médio Absoluto): {mae:.4f}')
print(f'MSE (Erro Quadrático Médio): {mse:.4f}')
print(f'R² (Coeficiente de Determinação): {r2:.4f}')

# Visualização da reta ajustada
plt.figure(figsize=(9, 6))
plt.scatter(
    X_train,
    y_train,
    color='blue',
    label='Dados de Treino (2006-2021)',
    s=60,
)
plt.scatter(
    X_test,
    y_test,
    color='green',
    label='Dados de Teste Observados (2022-2025)',
    s=80,
    marker='s',
)
plt.scatter(
    X_test,
    y_pred,
    color='red',
    label='Valores Previstos pelo Modelo',
    s=80,
    marker='X',
)

# Criando x_range como DataFrame para evitar avisos do sklearn
x_range_raw = np.linspace(df['PIB_indice'].min(), df['PIB_indice'].max(), 100).reshape(-1, 1)
x_range = pd.DataFrame(x_range_raw, columns=['PIB_indice'])
y_range_pred = modelo.predict(x_range)

plt.plot(
    x_range['PIB_indice'],
    y_range_pred,
    color='orange',
    linestyle='--',
    linewidth=2,
    label='Reta da Regressão Linear',
)

plt.title('Regressão Linear: PIB vs Índice ABCR')
plt.xlabel('Índice do PIB')
plt.ylabel('Índice ABCR')
plt.legend()
plt.grid(True, linestyle='--', alpha=0.6)
plt.show()
